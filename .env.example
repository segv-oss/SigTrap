# =============================================================================
# SigTrap — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Backend (Go) -----------------------------------------------------------

# Admin secret for uploading source maps via CI/CD.
# Used in: POST /api/v1/artifacts/sourcemaps (Authorization: Bearer <token>)
SIGTRAP_ADMIN_TOKEN=change-me-to-a-long-random-secret

# Directory where the backend persists issues and source maps.
SIGTRAP_DATA_DIR=./data

# Port the Go HTTP server listens on.
SIGTRAP_PORT=8080

# --- Frontend (Vite) --------------------------------------------------------
# These are embedded at build time. Prefix all Vite env vars with VITE_.

# Base URL of the running backend API.
VITE_API_BASE=http://localhost:8080/api/v1

# Your project's UUID — must match the key sent in X-SigTrap-Project-Key.
VITE_PROJECT_KEY=123e4567-e89b-12d3-a456-426614174000

# Release version — must match the version uploaded with your source maps.
VITE_RELEASE_VERSION=v1.4.2-ab89c2
